Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 45; 48; 55
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
    - Class: moveit_rviz_plugin/PlanningScene
      Name: Planning Scene
      Enabled: true
      Planning Scene Topic: /move_group/monitored_planning_scene
      Robot Description: robot_description
    - Class: rviz/Marker
      Name: Taught Grasp TCP
      Enabled: true
      Marker Topic: /fixed_sim/grasp_marker
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.9
      Pitch: 0.45
      Yaw: 2.5
      Focal Point: {X: -0.15, Y: 0, Z: 0.45}
Window Geometry:
  Width: 1280
  Height: 800
