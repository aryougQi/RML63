<launch>
  <arg name="gui" default="false"/><arg name="rviz" default="false"/>
  <arg name="profile" default="1"/>
  <param name="use_sim_time" value="true"/>
  <param name="robot_description" textfile="$(find rml63_tools_description)/urdf/fixed_runtime.urdf"/>
  <param name="sim_robot_description" command="$(find rml63_fixed_sim)/scripts/robot_description.py"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rml63_fixed_sim)/worlds/scene.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="$(eval not arg('gui'))"/>
  </include>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_arm" args="-urdf -param sim_robot_description -model rml63_fixed" output="screen"/>
  <rosparam ns="arm/joint_state_controller">{type: joint_state_controller/JointStateController, publish_rate: 50}</rosparam>
  <rosparam command="load" file="$(find rml63_fixed_sim)/config/controllers.yaml"/>
  <node pkg="controller_manager" type="spawner" name="controllers" ns="arm" args="joint_state_controller arm_joint_controller" output="screen"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <remap from="joint_states" to="/arm/joint_states"/>
  </node>
  <node pkg="topic_tools" type="relay" name="joint_states_relay" args="/arm/joint_states /joint_states"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_tf" args="0 0 0.5 0 0 -3.14 world dummy"/>
  <param name="robot_description_semantic" textfile="$(find rml63_tools_description)/config/rml63_with_gripper.srdf"/>
  <rosparam command="load" file="$(find rml_63_moveit_config)/config/joint_limits.yaml" ns="robot_description_planning"/>
  <rosparam command="load" file="$(find rml_63_moveit_config)/config/kinematics.yaml" ns="robot_description_kinematics"/>
  <include ns="move_group" file="$(find rml_63_moveit_config)/launch/planning_pipeline.launch.xml"/>
  <group ns="move_group">
    <param name="moveit_controller_manager" value="moveit_simple_controller_manager/MoveItSimpleControllerManager"/>
    <rosparam command="load" file="$(find rml63_fixed_sim)/config/moveit_controllers.yaml"/>
    <param name="moveit_manage_controllers" value="false"/>
  </group>
  <node pkg="moveit_ros_move_group" type="move_group" name="move_group" output="screen">
    <param name="allow_trajectory_execution" value="true"/>
    <param name="planning_scene_monitor/publish_planning_scene" value="true"/>
    <param name="planning_scene_monitor/publish_geometry_updates" value="true"/>
    <param name="planning_scene_monitor/publish_state_updates" value="true"/>
  </node>
  <node pkg="rml63_fixed_sim" type="scene.py" name="fixed_scene" output="screen" required="true">
    <param name="profile" value="$(arg profile)"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find rml63_fixed_sim)/config/scene.rviz"/>
</launch>
