<launch>
  <arg name="calibration_file" default="$(find rml63_handeye)/config/active_joint_calibration.yaml"/>
  <node name="rml63_handeye_tf" pkg="rml63_handeye" type="publish_joint_calibration.py" output="screen" required="true">
    <param name="calibration_file" value="$(arg calibration_file)"/>
    <param name="max_joint_age_sec" value="0.5"/>
  </node>
</launch>
