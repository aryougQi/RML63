<launch>
  <arg name="execute" default="false"/>
  <arg name="tag_size_verified" default="false"/>
  <arg name="namespace_prefix" default="rml63_l515"/>
  <arg name="rotation_delta_degrees" default="10"/>
  <arg name="translation_delta_meters" default="0.02"/>
  <arg name="tf_max_age_sec" default="0.8"/>
  <arg name="tf_wait_timeout_sec" default="5.0"/>
  <arg name="settle_timeout_sec" default="10.0"/>
  <node name="rml63_auto_calibrate" pkg="rml63_handeye" type="auto_calibrate.py" output="screen">
    <param name="execute" value="$(arg execute)"/>
    <param name="tag_size_verified" value="$(arg tag_size_verified)"/>
    <param name="calibration_namespace" value="/$(arg namespace_prefix)_eye_on_hand"/>
    <param name="rotation_delta_degrees" value="$(arg rotation_delta_degrees)"/>
    <param name="translation_delta_meters" value="$(arg translation_delta_meters)"/>
    <param name="tf_max_age_sec" value="$(arg tf_max_age_sec)"/>
    <param name="tf_wait_timeout_sec" value="$(arg tf_wait_timeout_sec)"/>
    <param name="settle_timeout_sec" value="$(arg settle_timeout_sec)"/>
  </node>
</launch>
